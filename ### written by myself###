    connect = [[] for _ in range(vertices + 1)]  # 邻接表

    # 构建邻接表和入度数组
    for u, v in graph:
        connect[u].append(v)
        in_degree[v] += 1
    
    queue = deque()
    # 初始化队列入度为0的节点
