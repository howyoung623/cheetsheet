滑动窗口

from collections import deque

def max_in_sliding_window(nums, k):
    if not nums or k == 0:
        return []
    

    result = []
    window = deque()  # 存储的是索引
    
    for i, num in enumerate(nums):
        # 移除 deque 中小于当前数的索引，因为它们不可能是最大值
        while window and nums[window[-1]] < num:
            window.pop()
        window.append(i)
        
        # 移除窗口外的索引
        if window[0] == i - k:
            window.popleft()
        
        # 当窗口大小达到 k 时，记录最大值
        if i >= k - 1:
            result.append(nums[window[0]])
    
    return result

